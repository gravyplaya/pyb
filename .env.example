# PYB environment — copy to .env.local (dev) or set in Dokploy (prod).
# Never commit real values; .env* is gitignored.

# Congress.gov API v3 key (required)
CONGRESS_API_KEY=

# Postgres (required). Local dev: postgres://pyb:pybdev@localhost:55432/pyb
# Dokploy: internal connection string + sslmode=require if remote.
DATABASE_URL=

# OpenRouter (required for chat, Phase 3)
OPENROUTER_API_KEY=

# Run the 15-min Congress sync poller (dev opt-in; prod default on)
PYB_SYNC=1

# Bearer token protecting POST /api/sync (optional)
PYB_SYNC_TOKEN=
